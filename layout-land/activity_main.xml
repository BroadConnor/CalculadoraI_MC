<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="6dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ellipsize="end"
        android:gravity="bottom|end"
        android:maxLines="2"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="7"
        android:rowCount="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay">

        <!-- Fila 1 -->
        <Button android:id="@+id/btnINV" android:text="INV" style="@style/CalculatorButtonStyle" android:textColor="#FFC107"/>
        <Button android:id="@+id/btnSin" android:text="sin" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btnCos" android:text="cos" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btnTan" android:text="tan" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btn7" android:text="7" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalculatorButtonStyle"/>

        <!-- Fila 2 -->
        <Button android:id="@+id/btnLog" android:text="log" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btnSqrt" android:text="√" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btnPower" android:text="^" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btnPi" android:text="π" style="@style/CalculatorButtonStyle" android:textColor="#03A9F4"/>
        <Button android:id="@+id/btn4" android:text="4" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalculatorButtonStyle"/>

        <!-- Fila 3 -->
        <Button android:id="@+id/btnOpenBracket" android:text="(" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btnCloseBracket" android:text=")" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btnC" android:text="C" style="@style/CalculatorButtonStyle" android:textColor="#FF5252"/>
        <Button android:id="@+id/btnDel" android:text="⌫" style="@style/CalculatorButtonStyle" android:textColor="#FF5252"/>
        <Button android:id="@+id/btn1" android:text="1" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalculatorButtonStyle"/>

        <!-- Fila 4 -->
        <Button android:id="@+id/btnDivide" android:text="÷" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btnMinus" android:text="-" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/CalculatorButtonStyle" android:textColor="#4CAF50"/>
        <Button android:id="@+id/btn0" android:text="0" style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btnDot" android:text="." style="@style/CalculatorButtonStyle"/>
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/CalculatorButtonStyle" android:backgroundTint="#4CAF50" android:textColor="#FFFFFF"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>